{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Navikultura: API (preview)",
      "type": "shell",
      "command": "npm.cmd run dev:preview",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    },
    {
      "label": "Navikultura: Web (HMR)",
      "type": "shell",
      "command": "npm.cmd run dev:web",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    },
    {
      "label": "Navikultura: Start API + Web",
      "dependsOn": [
        "Navikultura: API (preview)",
        "Navikultura: Web (HMR)"
      ],
      "dependsOrder": "parallel",
      "problemMatcher": []
    },
    {
      "label": "Navikultura: Run checks",
      "type": "shell",
      "command": "npm.cmd run check",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Navikultura: API (PostgreSQL)",
      "type": "shell",
      "command": "npm.cmd run dev:api",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    },
    {
      "label": "Navikultura: Kiosk preview (Edge fullscreen)",
      "type": "shell",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-Command",
        "$paths=@((Join-Path ([Environment]::GetFolderPath('ProgramFilesX86')) 'Microsoft\\Edge\\Application\\msedge.exe'),(Join-Path ([Environment]::GetFolderPath('ProgramFiles')) 'Microsoft\\Edge\\Application\\msedge.exe')); $edge=$paths|Where-Object{Test-Path -LiteralPath $_}|Select-Object -First 1; if(-not $edge){throw 'Microsoft Edge не найден'}; Start-Process -FilePath $edge -ArgumentList @('--kiosk','http://127.0.0.1:5173/screen','--edge-kiosk-type=fullscreen','--no-first-run')"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    }
  ]
}
