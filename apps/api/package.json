{
  "name": "@navikultura/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --test src/*.test.ts",
    "start": "node dist/index.js",
    "migrate": "tsx src/migrate.ts",
    "bootstrap:admin": "tsx src/bootstrap-admin.ts",
    "create:user": "tsx src/create-user.ts",
    "dev:preview": "tsx watch src/index-preview.ts"
  },
  "dependencies": {
    "fastify": "^5.12.8",
    "pg": "^8.16.3",
    "mammoth": "^1.13.0",
    "sanitize-html": "^2.18.2"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.3",
    "@types/pg": "^8.15.5",
    "@types/sanitize-html": "^2.16.2"
  }
}
